{
  "name": "39pos-enterprise",
  "version": "1.0.0",
  "private": true,
  "description": "39POS Enterprise Point of Sale System",
  "main": "electron/dist/main.js",
  "author": "39POS Enterprise",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces",
    "build:electron": "cd electron && npx tsc -p tsconfig.json",
    "electron:dev": "npm run build && npm run build:electron && electron .",
    "electron:pack": "npm run build && npm run build:electron && electron-builder --dir",
    "electron:dist": "npm run build && npm run build:electron && electron-builder --win",
    "test": "npm run test --workspaces",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5"
  }
}
